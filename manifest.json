{
  "id": "sbtbs-bus-reservation-app",
  "name": "Simple Bus Ticket Booking System",
  "short_name": "BusBooking",
  "description": "Book bus tickets, check live PNR status, and manage routes, seats, and reservations.",
  "lang": "en-US",
  "dir": "ltr",
  "start_url": "./index.php",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "tabbed", "standalone"],
  "tab_strip": {
    "home_tab": "auto",
    "new_tab_button": {
      "url": "./index.php"
    }
  },
  "orientation": "any",
  "launch_handler": {
    "client_mode": ["focus-existing", "auto"]
  },
  "edge_side_panel": {
    "preferred_width": 400
  },
  "background_color": "#212529",
  "theme_color": "#212529",
  "categories": ["travel", "transportation", "productivity"],
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ce4e53b7",
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://bus-resrvation.onrender.com/manifest.json",
      "id": "sbtbs-bus-reservation-app"
    }
  ],
  "note_taking": {
    "new_note_url": "./index.php?action=new_note"
  },
  "scope_extensions": [
    {
      "origin": "https://bus-resrvation.onrender.com"
    }
  ],
  "icons": [
    {
      "src": "assets/img/app-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/img/app-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "assets/img/app-icon.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "screenshots": [
    {
      "src": "assets/img/screenshot-wide.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Bus Ticket Booking Desktop Dashboard"
    },
    {
      "src": "assets/img/screenshot-narrow.png",
      "sizes": "720x1280",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Mobile Bus Ticket Booking and PNR Tracker"
    }
  ],
  "shortcuts": [
    {
      "name": "Book Tickets",
      "short_name": "Book",
      "description": "Search routes and reserve bus seats",
      "url": "./index.php",
      "icons": [
        {
          "src": "assets/img/app-icon.svg",
          "sizes": "512x512"
        }
      ]
    },
    {
      "name": "Admin Dashboard",
      "short_name": "Admin",
      "description": "Manage buses, routes, and bookings",
      "url": "./admin/dashboard.php",
      "icons": [
        {
          "src": "assets/img/app-icon.svg",
          "sizes": "512x512"
        }
      ]
    }
  ],
  "file_handlers": [
    {
      "action": "./pnr.php",
      "name": "Bus Ticket Voucher",
      "icons": [
        {
          "src": "assets/img/app-icon.svg",
          "sizes": "512x512",
          "type": "image/svg+xml"
        }
      ],
      "accept": {
        "application/json": [".json"],
        "text/plain": [".ticket", ".txt"]
      }
    },
    {
      "action": "./admin/dashboard.php",
      "name": "Bus Booking & Manifest Report",
      "icons": [
        {
          "src": "assets/img/app-icon.svg",
          "sizes": "512x512",
          "type": "image/svg+xml"
        }
      ],
      "accept": {
        "text/csv": [".csv"]
      }
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+bus",
      "url": "./pnr.php?pnr=%s"
    },
    {
      "protocol": "web+ticket",
      "url": "./pnr.php?ticket=%s"
    }
  ],
  "share_target": {
    "action": "./pnr.php",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "widgets": [
    {
      "name": "Bus Departure & PNR Tracker",
      "description": "View live bus departures and quick ticket status",
      "tag": "bus-departure-widget",
      "template": "bus-departure-widget-template",
      "ms_ac_template": "widgets/bus-widget.json",
      "data": "widgets/bus-widget-data.json",
      "type": "application/json",
      "auth": false,
      "update": 900,
      "screenshots": [
        {
          "src": "assets/img/screenshot-wide.png",
          "sizes": "1280x720",
          "label": "Bus Widget Preview"
        }
      ],
      "icons": [
        {
          "src": "assets/img/app-icon.svg",
          "sizes": "512x512"
        }
      ]
    }
  ]
}
