# Database Configuration for Bus Reservation System
# Replace with your MySQL or TiDB Cloud credentials

DB_HOST=gateway01.ap-south-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=your_db_username
DB_PASS=your_db_password
DB_NAME=test
DB_SSL=true

# Server Port (optional, default: 80 or 10000)
PORT=80

# Booking & Cancellation Rules (Phases 1.6, 3.5)
APP_BOOKING_CUTOFF_MIN=30
APP_CANCEL_CUTOFF_MIN=120

# Mail / Transactional Email Configuration (Phases 3.1, 4.2, Migration 011)
# Option A (Recommended for Render / Cloud): Brevo HTTPS REST API over port 443
BREVO_API_KEY=xkeysib-your_brevo_api_key
EMAIL_FROM="Bus Reservation System <reservations@example.com>"

# Option B: Standard SMTP Relay (Set MAIL_ENABLED=true when SMTP relay is configured)
MAIL_ENABLED=false
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=apikey
MAIL_PASS=your_smtp_secret_or_api_key
MAIL_FROM=reservations@example.com
MAIL_FROM_NAME="Bus Reservation System"

# Password Reset Link Configuration (Migration 011)
# Public origin used in password reset emails (never built from untrusted Host header in production)
APP_URL=https://bus-resrvation.onrender.com
PASSWORD_RESET_TTL_MIN=10

# Security & Multi-Factor Authentication
# By default, 2FA is optional. Set ADMIN_MFA_ENFORCE=true to strictly require 2FA on admin logins.
ADMIN_MFA_ENFORCE=false
